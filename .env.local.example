NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Optional, but strongly recommended on a machine with more than one Supabase
# project. The Supabase CLI keeps ONE login for the whole computer (a single
# Windows Credential Manager entry, "Supabase CLI:supabase"), shared by every
# project on it -- so anything that runs `supabase login` for a different
# project silently signs this one out, and `npm run db:push` then fails with a
# 403 about privileges that looks like a permissions bug on this project.
#
# Setting this pins the CLI to the account that owns THIS project: the
# environment variable takes precedence over the shared credential store.
# Generate one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
